{
  "version": 8,
  "name": "{{NAME}}",
  "sources": { "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" } },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "{{LAND}}" } },
    {
      "id": "landcover-natural", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["!=", "class", "ice"],
      "paint": { "fill-color": "{{NATURAL}}", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse-park", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "park", "recreation_ground", "village_green", "grass", "cemetery"],
      "paint": { "fill-color": "{{PARK}}" }
    },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "{{PARK}}" } },
    {
      "id": "landuse-hospital", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "hospital"],
      "paint": { "fill-color": "{{HOSPITAL}}" }
    },
    {
      "id": "landuse-airport", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "aerodrome"],
      "paint": { "fill-color": "{{AIRPORT}}" }
    },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "{{WATER}}" } },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 9,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{WATER}}", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 15, 3.0] }
    },
    {
      "id": "aeroway-fill", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "{{AIRPORT}}" }
    },
    {
      "id": "aeroway-line", "type": "line", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", "$type", "LineString"],
      "paint": { "line-color": "{{AIRPORT}}", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.0, 15, 6.0] }
    },
    {
      "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "{{BUILDING}}" }
    },
    {
      "id": "road-local-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 14,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "minor", "service", "track"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_LOCAL_CASE}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 2.2, 16, 6.0] }
    },
    {
      "id": "road-local", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "minor", "service", "track"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_LOCAL}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.5, 16, 4.5] }
    },
    {
      "id": "road-arterial-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "primary", "secondary", "tertiary"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_ART_CASE}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 1.2, 16, 11.0] }
    },
    {
      "id": "road-arterial", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "primary", "secondary", "tertiary"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_ART}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 0.7, 16, 9.0] }
    },
    {
      "id": "road-highway-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 6,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "motorway", "trunk"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_HWY_CASE}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 1.5, 16, 14.0] }
    },
    {
      "id": "road-highway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 6,
      "filter": ["all", ["!=", "brunnel", "tunnel"], ["in", "class", "motorway", "trunk"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "{{ROAD_HWY}}", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 0.9, 16, 11.5] }
    },
    {
      "id": "label-water", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "minzoom": 11,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 15, 13],
        "symbol-placement": "line"
      },
      "paint": { "text-color": "{{LBL_WATER}}", "text-halo-color": "{{LBL_WATER_HALO}}", "text-halo-width": 1.2 }
    },
    {
      "id": "label-road", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13.5,
      "filter": ["!in", "class", "rail", "transit", "path", "track", "service"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13.5, 10, 16, 12],
        "symbol-placement": "line", "text-max-angle": 30
      },
      "paint": { "text-color": "{{LBL_ROAD}}", "text-halo-color": "{{LAND}}", "text-halo-width": 1.5 }
    },
    {
      "id": "label-suburb", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 11, "maxzoom": 15,
      "filter": ["in", "class", "suburb", "neighbourhood", "quarter"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 14, 12],
        "text-transform": "uppercase", "text-letter-spacing": 0.08
      },
      "paint": { "text-color": "{{LBL_SUBURB}}", "text-halo-color": "{{LAND}}", "text-halo-width": 1.5 }
    },
    {
      "id": "label-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 16, 15, 19]
      },
      "paint": { "text-color": "{{LBL_CITY}}", "text-halo-color": "{{LAND}}", "text-halo-width": 1.8 }
    },
    {
      "id": "label-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "maxzoom": 7,
      "filter": ["in", "class", "country", "continent"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"], "text-size": 12
      },
      "paint": { "text-color": "{{LBL_COUNTRY}}", "text-halo-color": "{{LAND}}", "text-halo-width": 1.5 }
    }
  ]
}
